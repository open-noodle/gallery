# Eval harness local config. Copy to `.env` (gitignored) and fill in.
# Loaded automatically by `pnpm eval` / `pnpm eval:l3` (node --env-file-if-exists=.env).
# See eval/config.mjs for the full list of overrides.

# --- L1 (component, default): a local OpenAI-compatible model ---------------
# EVAL_LLAMA_URL=http://127.0.0.1:8080/v1
# EVAL_LLAMA_MODEL=Qwen3-Coder-Next-Q8_0-00001-of-00004.gguf

# --- L3 (live, --layer L3): the real Gallery /agent/* API, read-only --------
# GALLERY_URL=http://localhost:2283/api
# One auth method:
# GALLERY_API_KEY=...          # x-api-key (preferred for headless runs)
# GALLERY_TOKEN=...            # bearer access token
# GALLERY_EMAIL=...            # or login to mint a bearer
# GALLERY_PASSWORD=...
# Optional credential/model pinning (else auto-picks the first openai-compatible credential):
# GALLERY_CREDENTIAL_ID=...
# GALLERY_MODEL=...
