{
  "actor": "me",
  "description": "Photos with a city: availability only",
  "ids": {},
  "request": {
    "body": {
      "city": "Kyoto",
      "dimensions": [
        "availability"
      ],
      "visibility": "timeline",
      "withPartners": true,
      "withSharedSpaces": true
    },
    "headers": {
      "x-gallery-app": "search-contract"
    },
    "method": "POST",
    "path": "/api/search/options"
  },
  "response": {
    "body": {
      "availability": {
        "hasAssets": true,
        "hasAssetsInAlbum": true,
        "hasAssetsNotInAlbum": true,
        "hasCameras": true,
        "hasFavorites": true,
        "hasImages": true,
        "hasPeople": true,
        "hasPlaces": true,
        "hasRatings": true,
        "hasTags": true,
        "hasVideos": false
      }
    },
    "status": 200
  }
}
