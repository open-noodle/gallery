{
  "actor": "me",
  "description": "Gallery server before searchFavoritesAcrossSpaces, Favorites screen: my own favourites, archived ones too: availability only",
  "ids": {},
  "request": {
    "body": {
      "dimensions": [
        "availability"
      ],
      "isFavorite": true
    },
    "headers": {
      "x-gallery-app": "search-contract"
    },
    "method": "POST",
    "path": "/api/search/options"
  },
  "response": {
    "body": {
      "availability": {
        "hasAssets": true,
        "hasAssetsInAlbum": true,
        "hasAssetsNotInAlbum": true,
        "hasCameras": true,
        "hasFavorites": true,
        "hasImages": true,
        "hasPeople": true,
        "hasPlaces": true,
        "hasRatings": true,
        "hasTags": false,
        "hasVideos": false
      }
    },
    "status": 200
  }
}
